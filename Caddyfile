{
    frankenphp
    order php_server before file_server
}

:80 {
    root * public
    encode zstd gzip

    # Cache agressivo para arquivos estáticos (1 ano)
    @static {
        file
        path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.webp *.woff *.woff2
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    php_server
    file_server
}
